audio:
  carrier_validity_min_delta: 0.1
  carrier_validity_timeout_sec: 2.5
  chunk_size: 960
  compressor_attack_ms: 8.0
  compressor_enabled: true
  compressor_makeup_db: 3.8
  compressor_ratio: 3.0
  compressor_release_ms: 160.0
  compressor_strength: 50
  compressor_threshold_db: -20.0
  dual_input: false
  dual_output: false
  output_2_mode: simulcast
  highpass_cutoff: 250
  highpass_enabled: false
  input_index: 0
  input_index_2: 1
  input_device_2: 1
  limiter_enabled: true
  limiter_threshold: 0.85
  notch_enabled: true
  notch_frequency_hz: 60.0
  notch_harmonics: 2
  notch_q: 30.0
  output_device_2: 5
  output_index: 2
  sample_rate: 48000
  speex_ns_enabled: false
  speex_ns: false
  speex_ns_db: -20
  speex_agc: false
  speex_agc_level: 8000
  speex_vad: false
  squelch_hang_time: 0.5
  squelch_hysteresis_db: 5.0
  squelch_threshold: -54
  tx_tone: 0.75
  tx_tone_eq_enabled: true
identification:
  callsign: K3AYV
  cw_enabled: true
  cw_pitch: 900
  cw_volume: 20
  cw_wpm: 20
  interval_minutes: 10
ptt:
  device_path: FAKE
  dual_ptt: false
  gpio_pin: '3'
  mode: CM108
  primary:
    device_path: FAKE
    gpio_pin: '3'
    mode: CM108
  secondary:
    device_path: FAKE
    gpio_pin: '3'
    mode: CM108
repeater:
  anti_kerchunk_time: 0
  auto_start: true
  carrier_delay: 0
  courtesy_tone_enabled: false
  courtesy_tone_volume: 100
  tail_time: 2.0
tot:
  tot_enabled: true
  tot_lockout_enabled: true
  tot_lockout_time: 5
  tot_time: 180
  tot_tone_freq: 1200
  tot_volume: 100
